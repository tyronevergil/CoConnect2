@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="bg-light">
<div class="container mt-4">

    <div class="row">

        <div class="col-md-4">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">Add Contact</div>

                <div class="card-body">
                    <form id="contactForm">

                        <div class="mb-3">
                            <label class="form-label">First Name</label>
                            <input type="text" class="form-control" id="firstName" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Last Name</label>
                            <input type="text" class="form-control" id="lastName" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" id="email">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" id="phone">
                        </div>

                        <button class="btn btn-primary w-100">Add Contact</button>

                    </form>
                </div>

            </div>

        </div>

        <div class="col-md-8">

            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">Contacts</div>

                <div class="card-body">

                    <table id="contactsTable" class="table table-striped">
                        <thead class="table-light">
                            <tr>
                                <th>First</th>
                                <th>Last</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>

                </div>
            </div>

        </div>

    </div>

</div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Edit Contact</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="editContactId">

                <div class="mb-3">
                    <label class="form-label">First Name</label>
                    <input type="text" class="form-control" id="editFirst">
                </div>

                <div class="mb-3">
                    <label class="form-label">Last Name</label>
                    <input type="text" class="form-control" id="editLast">
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" id="editEmail">
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone</label>
                    <input type="text" class="form-control" id="editPhone">
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="saveEdit" class="btn btn-primary">Save</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
	<script>
		(function(app, $) {

			app.ready(function () {

				var table = $('#contactsTable').DataTable({
					columnDefs: [{ orderable: false, targets: 4 }]
				});

				var editModal = new bootstrap.Modal(document.getElementById('editModal'));

                app.get("load contacts", "/api/query/contacts/")
                .done(function (data) {
                    console.log(data);

                    data.forEach(function(item) {
                        let first = item.firstname;
                        let last = item.lastname;
                        let email = item.email;
                        let phone = item.phone;

                        let node = table.row.add([
                            first,
                            last,
                            email,
                            phone,
                            `<button class="btn btn-sm btn-outline-primary edit">Edit</button>
                             <button class="btn btn-sm btn-outline-danger delete">Delete</button>`
                        ]).node();

                        $(node).attr("id", item.contactId);
                    });

                    table.draw();
                });

                app.on("created.contact", function(e, data) {
                    console.log(e, data);

                    app.get("load created contact", "/api/query/contacts/" + data.contactId)
                    .done(function (item) {
                        console.log(item);

                        let first = item.firstname;
                        let last = item.lastname;
                        let email = item.email;
                        let phone = item.phone;

                        let node = table.row.add([
                            first,
                            last,
                            email,
                            phone,
                            `<button class="btn btn-sm btn-outline-primary edit">Edit</button>
                             <button class="btn btn-sm btn-outline-danger delete">Delete</button>`
                        ]).node();

                        $(node).attr("id", item.contactId);

                        table.draw();

                        app.showToast('Contact created successfully', 'success');
                    });
                });

                app.on("updated.contact", function(e, data) {
                    console.log(e, data);

                    let row = table.row("#" + data.contactId);
                    if (!row.any()) return;

                    app.get("load updated contact", "/api/query/contacts/" + data.contactId)
                    .done(function (item) {
                        console.log(item);

                        let first = item.firstname;
                        let last = item.lastname;
                        let email = item.email;
                        let phone = item.phone;

                        row.data([
                            first,
                            last,
                            email,
                            phone,
                            `<button class="btn btn-sm btn-outline-primary edit">Edit</button>
                            <button class="btn btn-sm btn-outline-danger delete">Delete</button>`
                        ]).draw(false);

                        app.showToast('Contact updated successfully', 'success');
                    });
                });

                app.on("deleted.contact", function(e, data) {
                    console.log(e, data);

                    let row = table.row("#" + data.contactId);
                    if (!row.any()) return;

                    row.remove().draw();

                    app.showToast('Contact deleted successfully', 'success');
                });

                $('#contactForm').submit(function(e){

                    e.preventDefault();

                    let first = $('#firstName').val();
                    let last = $('#lastName').val();
                    let email = $('#email').val();
                    let phone = $('#phone').val();

                    let form = this;

                    app.post("create contact", '/api/command/CreateContact', {
                        firstname: first,
                        lastname: last,
                        email: email,
                        phone: phone
                    })
                    .done(function (data, textStatus, xhr) {
                        console.log('Contact create command sent. Status:', xhr.status);
                        form.reset();
                    });

                });

                $('#contactsTable tbody').on('click', '.delete', function () {

                    let row = table.row($(this).parents('tr'));
                    let contactIdToDelete = row.node().id;

                    app.showConfirm({
                        title: 'Confirm Delete',
                        message: 'Are you sure you want to delete this contact?',
                        okText: 'Delete',
                        cancelText: 'Cancel',
                        okButtonClass: 'btn-danger'
                    })
                    .then(function (confirmed) {
                        if (!confirmed) return;

                        app.post("delete contact", '/api/command/DeleteContact', {
                            contactId: contactIdToDelete
                        })
                        .done(function () {
                            console.log('Contact delete command sent');
                        });
                    });

                });

                $('#contactsTable tbody').on('click', '.edit', function () {

                    let row = table.row($(this).parents('tr'));
                    let data = row.data();

                    $('#editContactId').val(row.node().id);

                    $('#editFirst').val(data[0]);
                    $('#editLast').val(data[1]);
                    $('#editEmail').val(data[2]);
                    $('#editPhone').val(data[3]);

                    editModal.show();

                });

                $('#saveEdit').click(function(){

                    let id = $('#editContactId').val();
                    let first = $('#editFirst').val();
                    let last = $('#editLast').val();
                    let email = $('#editEmail').val();
                    let phone = $('#editPhone').val();

                    app.post("update contact", '/api/command/UpdateContact', {
                        contactId: id,
                        firstname: first,
                        lastname: last,
                        email: email,
                        phone: phone
                    })
                    .done(function () {
                        console.log('Contact update command sent');
                        editModal.hide();
                    });

                });

            });

        })(window.app, window.jQuery)
    </script>
}
