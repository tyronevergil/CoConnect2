{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "restore",
      "type": "process",
      "command": "dotnet",
      "args": ["restore", "CoConnect/CoConnect.csproj"],
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "CoConnect/CoConnect.csproj"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "--project", "CoConnect/CoConnect.csproj", "run"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    }
  ]
}
